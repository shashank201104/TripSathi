{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/build",
  "routes": [
    { "src": "^/destinations$", "dest": "/destinations/", "status": 301 },
    { "src": "^/destinations/(jaipur|ladakh|kerala)$", "dest": "/destinations/$1/", "status": 301 },
    { "src": "^/blog$", "dest": "/blog/", "status": 301 },
    { "src": "^/blog/([a-z0-9-]+)$", "dest": "/blog/$1/", "status": 301 },
    { "src": "^/(about|contact|privacy)$", "dest": "/$1/", "status": 301 },
    { "handle": "filesystem" },
    {
      "src": "^/(auth/login|auth/register|login|register|dashboard|trip-planner|plan|maps|profile)/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/trips(/[^/]+)?/?$",
      "dest": "/index.html"
    },
    { "src": "^/404/?$", "dest": "/404.html", "status": 404 },
    { "src": "^/.*$", "dest": "/404.html", "status": 404 }
  ]
}
